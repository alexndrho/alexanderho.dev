<div
  class="scroll-progress__bar"
  role="progressbar"
  aria-label="Scroll progress"
  aria-valuemin="0"
  aria-valuemax="100"
  aria-valuenow="0"
>
  <div class="scroll-progress__fill"></div>
</div>

<script>
  document.addEventListener("astro:page-load", () => {
    const bar = document.querySelector(".scroll-progress__bar") as HTMLDivElement | null;
    const fill = document.querySelector(".scroll-progress__fill") as HTMLDivElement | null;

    if (!bar || !fill) return;

    const updateProgress = () => {
      const scrollableHeight = document.documentElement.scrollHeight - window.innerHeight;
      const progress = scrollableHeight ? window.scrollY / scrollableHeight : 0;
      const percent = Math.min(100, Math.max(0, progress * 100));

      fill.style.width = `${percent}%`;
      bar.setAttribute("aria-valuenow", Math.round(percent).toString());
    };

    window.addEventListener("scroll", updateProgress, { passive: true });
    updateProgress();
  });
</script>

<style>
  .scroll-progress__bar {
    position: fixed;
    top: 0;
    left: var(--menu-width, 0);
    right: 0;

    height: 0.25em;
    background-color: transparent;
    display: block;
    pointer-events: none;
    z-index: 100;
    overflow: hidden;
  }

  .scroll-progress__fill {
    height: 100%;
    background-color: var(--color-primary);
    width: 0%;
    transition: width 0.2s ease;
  }
</style>
