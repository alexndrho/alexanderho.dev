---
import { Image } from "astro:assets";
import { FaLock } from "react-icons/fa";

import WindowControls from "./WindowControls.astro";
import { stripUrlProtocol } from "@/utils/string";

interface Props {
  url?: string | undefined;
  image: ImageMetadata;
  class?: string;
}

const { url, image, class: className, ...rest } = Astro.props;

const computedUrl = url ? stripUrlProtocol(url) : "localhost:3000";
---

<div class:list={["mock", "container", className]} {...rest}>
  <div class="mock__head">
    <WindowControls />

    <p aria-label="website url" class="mock__url-bar">
      <FaLock />
      <span class="mock__url-label">{computedUrl}</span>
    </p>
  </div>

  <Image src={image} alt="preview" class="mock__img" />
</div>

<style>
  .mock {
    padding: 0;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .mock__head {
    width: 100%;
    padding: var(--spacing-xs) var(--spacing-sm);
    border-bottom: var(--border);

    background-color: var(--color-light);

    display: flex;
    align-items: center;
  }

  .mock__url-bar {
    font-size: var(--font-size-xs);
    width: 65%;

    margin: 0 auto 0;
    padding: 0.25em 0.5em;

    border-radius: var(--border-radius-sm);
    border: 1px solid var(--color-light-darkest);
    background-color: var(--color-light-darker);

    display: flex;
    align-items: center;
    gap: 0.5em;
  }

  .mock__url-label {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .mock__img {
    width: 100%;
    height: unset;
    aspect-ratio: var(--aspect-ratio-video);
    object-fit: cover;
    border-radius: unset;
  }
</style>
