---
import { getCollection } from "astro:content";
import { TbArrowRight } from "react-icons/tb";

import GalleryPreview from "../GalleryPreview.astro";

const gallery = (await getCollection("gallery"))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<section id="gallery" class="section">
  <div class="layout layout--section">
    <div class="layout--section__banner">
      <h2 class="layout--section__banner__title">Gallery</h2>
      <a href="/gallery" class="link link--with-icon">
        View full gallery
        <TbArrowRight size="1em" />
      </a>
    </div>

    <GalleryPreview gallery={gallery} />
  </div>
</section>
