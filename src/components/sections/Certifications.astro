---
import { certificationPreview } from "@/constants/certifications";
import { TbArrowRight } from "react-icons/tb";

import CertificationsPreview from "../CertificationsPreview.astro";
---

<section id="certifications" class="section">
  <div class="layout layout--section">
    <div class="layout--section__banner">
      <h2 class="layout--section__banner__title">Certifications</h2>

      <a href="/certifications" class="link link--with-icon">
        View all certifications
        <TbArrowRight size="1em" />
      </a>
    </div>

    <CertificationsPreview certifications={certificationPreview} />
  </div>
</section>

<style></style>
