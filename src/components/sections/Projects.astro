---
import { TbArrowRight } from "react-icons/tb";

import ProjectCard from "@components/layouts/ProjectCard.astro";
import { projects } from "@/constants/projects";
---

<section id="projects" class="section">
  <div class="projects__container layout layout--section">
    <div class="layout--section__banner">
      <h2 class="layout--section__banner__title">Projects</h2>
      <a href="/projects" class="link link--with-icon">
        View all projects
        <TbArrowRight size="1em" />
      </a>
    </div>

    {
      projects
        .slice(0, 3)
        .map((project) => (
          <ProjectCard
            type={project.type}
            title={project.title}
            description={project.description}
            image={project.image}
            techStack={project.techStack}
            liveLink={project.liveLink}
            sourceLink={project.sourceLink}
          />
        ))
    }
  </div>
</section>

<style>
  .projects__container {
    display: flex;
    flex-direction: column;
  }
</style>
