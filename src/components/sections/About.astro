---
import { Image } from "astro:assets";
import {
  FaArrowRightArrowLeft,
  FaDesktop,
  FaDollarSign,
  FaGithub,
  FaImage,
  FaLanguage,
  FaLinux,
  FaMemory,
  FaMicrochip,
  FaRegHardDrive,
  FaRegWindowMaximize,
  FaTerminal,
} from "react-icons/fa6";

import Terminal from "@components/layouts/Terminal.astro";
import TerminalPrompt from "@components/TerminalPrompt.astro";
import LocalTime from "../LocalTime.astro";
import GitHubCalendar from "./react/GitHubCalendar";
import meCycling from "@/assets/me-cycling.jpg";
---

<section id="about" class="section">
  <div class="container container--section">
    <h2>About me</h2>

    <Terminal headline="skidy@fedora:~">
      <TerminalPrompt prompt="fastfetch">
        <div class="fastfetch">
          <Image src={meCycling} alt="Me cycling" draggable={false} class="fastfetch__image" />

          <div class="fastfetch__details">
            <p>skidy@fedora</p>
            <p>------------</p>
            <p>
              <span class="fastfetch__icon highlight">
                <FaLinux />
              </span>
               Fedora x86_64
            </p>
            <p>
              <span class="fastfetch__icon highlight">
                <FaDollarSign />
              </span>
               zsh
            </p>
            <p>
              <span class="fastfetch__icon highlight">
                <FaDesktop />
              </span>
               3840x2160 @ 2x in 13", 60 Hz [Built-in]
            </p>
            <p>
              <span class="fastfetch__icon highlight">
                <FaRegWindowMaximize />
              </span>
               niri
            </p>
            <p>
              <span class="fastfetch__icon highlight">
                <FaTerminal />
              </span>
               kitty
            </p>
            <p>
              <span class="fastfetch__icon highlight">
                <FaMicrochip />
              </span>
               Intel(R) Core(TM) i7-10510U (8) @ 4.90 GHz
            </p>
            <p>
              <span class="fastfetch__icon highlight">
                <FaImage />
              </span>
               NVIDIA GeForce MX250 [Discrete]
            </p>
            <p>
              <span class="fastfetch__icon highlight">
                <FaImage />
              </span>
               Intel UHD Graphics @ 1.15 GHz [Integrated]
            </p>
            <p>
              <span class="fastfetch__icon highlight">
                <FaMemory />
              </span>
               9.20 GiB / 15.31 GiB (60%)
            </p>
            <p>
              <span class="fastfetch__icon highlight">
                <FaArrowRightArrowLeft />
              </span>
               0 B / 8.00 GiB (0%)
            </p>
            <p>
              <span class="fastfetch__icon highlight">
                <FaRegHardDrive />
              </span>
               19.00 GiB / 474.35 GiB (4%) - btrfs
            </p>
            <p>
              <span class="fastfetch__icon highlight">
                <FaLanguage />
              </span>
               en_US.UTF-8
            </p>
            <p>------------</p>
          </div>
        </div>
      </TerminalPrompt>

      <TerminalPrompt prompt="ls">
        <ul class="ls-result">
          <li>whoami.txt</li>
          <li>interest.txt</li>
          <li>life.txt</li>
        </ul>
      </TerminalPrompt>

      <TerminalPrompt prompt="cat whoami.txt">
        <p>
          Hey, I'm Alex, a full stack developer from the Philippines. I took information technology in college because
          computers had already become the thing I spent most of my free time on. Online, I go by skidy. It means
          "script kiddie", a person who is an unskilled hacker who uses pre-written programs to launch attacks. I came
          up with that name because I used to create silly names online, and I only cling to that name because it is
          short.
        </p>
      </TerminalPrompt>

      <TerminalPrompt prompt="cat interest.txt">
        <p>
          I've always been interested in computers, and I started my programming journey during the pandemic. These
          days, I spend most of my time building and learning everything that makes computers tick. I love configuring
          and tinkering with my Linux system, including building my own desktop setup and shaping it to look and behave
          the way I want it. That same desire for control drew me to Neovim, because I wanted an editor I could shape
          around the way I think and work. It's not just about Neovim being faster or not having to move your hands from
          the keyboard to the mouse to navigate. It is also about the control, how you want it to be. For me,
          programming and learning things about computers is the same as when people feel when playing games.
        </p>
      </TerminalPrompt>

      <TerminalPrompt prompt="cat life.txt">
        <p>
          Do Neovim users even have lives? Kidding. Away from the screen, I try to stay curious and a little
          spontaneous. If I have not tried something before, that is usually enough reason to give it a shot. I used to
          spend more time at the gym and cycling around the city, but most of my energy has been going back into
          development.
        </p>
      </TerminalPrompt>

      <TerminalPrompt prompt="git remote get-url origin">
        <p>
          <a href="https://github.com/alexndrho/alexanderho.dev" class="link" target="_blank" rel="noreferrer">
            https://github.com/alexndrho/alexanderho.dev
            <FaGithub aria-hidden="true" className="git-url-origin-icon" />
          </a>
        </p>
      </TerminalPrompt>
    </Terminal>

    <div class="about__extra">
      <LocalTime />

      <div class="github-calendar-card">
        <p class="github-calendar-card__label">GitHub contributions</p>

        <GitHubCalendar client:only="react" username="alexndrho" />
      </div>
    </div>
  </div>

  <style>
    p {
      margin: 0;
    }

    .link {
      color: var(--color-light);
      text-decoration: underline;
    }

    .highlight {
      color: var(--color-primary);
    }

    .ls-result {
      list-style-type: none;
      margin: 0;
      padding: 0;
      display: flex;
      gap: var(--spacing-md);
    }

    .fastfetch {
      display: flex;
      flex-direction: column;
      gap: var(--spacing-md);
    }

    .fastfetch__image {
      width: 100%;
      aspect-ratio: 1;
      object-fit: cover;
      border-radius: var(--border-radius-md);
    }

    .fastfetch__icon {
      margin-right: var(--font-size-xs);
      display: inline-flex;
      justify-content: center;
      align-items: center;
      vertical-align: middle;
    }

    .git-url-origin-icon {
      margin-inline-start: 0.5em;
    }

    .about__extra {
      display: flex;
      flex-direction: column;
      gap: var(--spacing-md);
    }

    .github-calendar-card {
      min-width: 0;
      max-width: 100%;
      padding: var(--spacing-md);
      border-radius: var(--border-radius-md);
      box-shadow: var(--box-shadow);
      border: var(--border);
    }

    .github-calendar-card__label {
      margin-bottom: var(--spacing-md);
      font-size: var(--font-size-md);
      font-weight: 700;
    }

    @media (--md-viewport) {
      .fastfetch {
        flex-direction: row;
        width: 100%;
        align-items: flex-start;
      }

      .fastfetch__image {
        width: min(40%, 420px);
      }

      .fastfetch__details {
        flex: 1;
      }

      .about__extra {
        flex-direction: row;
        align-items: start;
      }
    }
  </style>
</section>
