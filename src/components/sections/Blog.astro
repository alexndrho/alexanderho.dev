---
import { getCollection } from "astro:content";
import { TbArrowRight } from "react-icons/tb";

import BlogPreview from "../BlogPreview.astro";

const blogs = (await getCollection("blog"))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 2);
---

<section id="blog" class="section">
  <div class="layout layout--section">
    <div class="layout--section__banner">
      <h2 class="layout--section__banner__title">Blog</h2>
      <a href="/blog" class="link link--with-icon">
        View all posts
        <TbArrowRight size="1em" />
      </a>
    </div>

    <BlogPreview blogs={blogs} />
  </div>
</section>
