---
import type { IconType } from "react-icons";
import { TbBrandGithub, TbExternalLink } from "react-icons/tb";

import WebsiteMock from "@components/WebsiteMock.astro";
import DesktopMock from "@components/DesktopMock.astro";

interface Props {
  type?: "website" | "desktop";
  title: string;
  description: string;
  image: ImageMetadata;
  techStack: {
    icon?: IconType;
    tech: string;
  }[];
  liveLink?: string;
  sourceLink?: string;
}

const { type = "website", title, description, image, techStack, liveLink, sourceLink } = Astro.props;
---

<article class="card">
  {
    type === "website" ? (
      <WebsiteMock url={liveLink} image={image} class="card__mock" />
    ) : (
      <DesktopMock image={image} class="card__mock" />
    )
  }

  <div class="card__info">
    <h3 class="card__title">{title}</h3>
    <p class="card__desc">{description}</p>

    <ul class="card__tech-stacks">
      {
        techStack.map((item) => {
          const Icon = item.icon;
          return (
            <li class="card__tech-stack">
              {Icon && <Icon />}
              {item.tech}
            </li>
          );
        })
      }
    </ul>

    <div class="card__links">
      {
        liveLink && (
          <a href={liveLink} target="_blank" rel="noreferrer" class="btn btn--primary btn--dashed-effect">
            Live
            <TbExternalLink className="card__link__icon" />
          </a>
        )
      }

      {
        sourceLink && (
          <a href={sourceLink} target="_blank" rel="noreferrer" class="btn btn--primary btn--dashed-effect">
            Source
            <TbBrandGithub className="card__link__icon" />
          </a>
        )
      }
    </div>
  </div>
</article>

<style>
  .card {
    margin-bottom: var(--spacing-lg);
    background-color: var(--color-light);
    padding: var(--spacing-lg);
    border: var(--border);
    border-radius: var(--border-radius-md);
    box-shadow: var(--box-shadow);

    display: flex;
    flex-direction: column;
    gap: var(--spacing-lg);
  }

  .card:last-child {
    margin-bottom: 0;
  }

  .card__info {
    display: flex;
    flex-direction: column;
  }

  .card__title {
    margin-bottom: var(--spacing-sm);
    font-size: var(--font-size-2xl);
  }

  .card__title::after {
    content: "";
    display: block;
    height: 0.15em;
    width: 10rem;
    background-color: var(--color-primary);
    border-radius: var(--border-radius-md);
  }

  .card .card__desc {
    margin-bottom: var(--spacing-sm);
    color: var(--color-secondary);
    font-weight: 500;
  }

  .card__tech-stacks {
    list-style-type: none;
    margin: 0;
    padding: 0;
    margin-bottom: var(--spacing-sm);
    display: flex;
    flex-direction: row;
    gap: var(--spacing-xs);
    flex-wrap: wrap;
  }

  .card__tech-stack {
    padding: 0.125em 0.5em;
    border-radius: var(--border-radius-sm);
    background-color: var(--color-secondary);
    color: var(--color-light);
    font-size: var(--font-size-xs);
    line-height: var(--line-height-xs);
    font-weight: 500;

    display: flex;
    align-items: center;
    gap: 0.25em;
  }

  .card__links {
    font-size: var(--font-size-sm);
    display: flex;
    flex-direction: row;
    gap: var(--spacing-sm);
  }

  .card__link__icon {
    font-size: var(--font-size-xl);
  }

  @media (--lg-viewport) {
    .card {
      align-items: center;
    }

    .card:nth-child(odd) {
      flex-direction: row-reverse;
    }

    .card:nth-child(even) {
      flex-direction: row;
    }

    .card__mock {
      min-width: 0;
      flex: 10;
    }

    .card__info {
      flex: 8;
    }
  }
</style>
