---
import type { IconType } from "react-icons";
import { TbBrandGithub, TbExternalLink } from "react-icons/tb";

import WebsiteMock from "@components/WebsiteMock.astro";
import DesktopMock from "@components/DesktopMock.astro";

interface Props {
  type?: "website" | "desktop";
  title: string;
  description: string;
  image: ImageMetadata;
  techStack: {
    icon?: IconType;
    tech: string;
  }[];
  liveLink?: string;
  sourceLink?: string;
}

const { type = "website", title, description, image, techStack, liveLink, sourceLink } = Astro.props;
---

<article class="project container">
  {
    type === "website" ? (
      <WebsiteMock url={liveLink} image={image} class="project__mock" />
    ) : (
      <DesktopMock image={image} class="project__mock" />
    )
  }

  <div class="project__info">
    <h3 class="project__title">{title}</h3>
    <p class="project__desc">{description}</p>

    <ul class="project__tech-stacks">
      {
        techStack.map((item) => {
          const Icon = item.icon;
          return (
            <li class="project__tech-stack">
              {Icon && <Icon />}
              {item.tech}
            </li>
          );
        })
      }
    </ul>

    <div class="project__links">
      {
        liveLink && (
          <a href={liveLink} target="_blank" rel="noreferrer" class="btn btn--primary btn--dashed-effect">
            Live
            <TbExternalLink className="project__link__icon" />
          </a>
        )
      }

      {
        sourceLink && (
          <a href={sourceLink} target="_blank" rel="noreferrer" class="btn btn--primary btn--dashed-effect">
            Source
            <TbBrandGithub className="project__link__icon" />
          </a>
        )
      }
    </div>
  </div>
</article>

<style>
  .project {
    margin-bottom: var(--spacing-lg);
    display: flex;
    flex-direction: column;
    gap: var(--spacing-lg);
  }

  .project:last-child {
    margin-bottom: 0;
  }

  .project__info {
    display: flex;
    flex-direction: column;
  }

  .project__title {
    margin-bottom: var(--spacing-sm);
    font-size: var(--font-size-2xl);
  }

  .project__title::after {
    content: "";
    display: block;
    height: 0.15em;
    width: 10rem;
    background-color: var(--color-primary);
    border-radius: var(--border-radius-md);
  }

  .project .project__desc {
    margin-bottom: var(--spacing-sm);
    color: var(--color-secondary);
    font-weight: 500;
  }

  .project__tech-stacks {
    list-style-type: none;
    margin: 0;
    padding: 0;
    margin-bottom: var(--spacing-sm);
    display: flex;
    flex-direction: row;
    gap: var(--spacing-xs);
    flex-wrap: wrap;
  }

  .project__tech-stack {
    padding: 0.125em 0.5em;
    border-radius: var(--border-radius-sm);
    background-color: var(--color-secondary);
    color: var(--color-light);
    font-size: var(--font-size-xs);
    line-height: var(--line-height-xs);
    font-weight: 500;

    display: flex;
    align-items: center;
    gap: 0.25em;
  }

  .project__links {
    font-size: var(--font-size-sm);
    display: flex;
    flex-direction: row;
    gap: var(--spacing-sm);
  }

  .project__link__icon {
    font-size: var(--font-size-xl);
  }

  @media (--lg-viewport) {
    .project {
      align-items: center;
    }

    .project:nth-child(odd) {
      flex-direction: row-reverse;
    }

    .project:nth-child(even) {
      flex-direction: row;
    }

    .project__mock {
      min-width: 0;
      flex: 10;
    }

    .project__info {
      flex: 8;
    }
  }
</style>
