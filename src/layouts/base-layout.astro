---
import BaseHead from "@components/base-head.astro";
import Shell, { type Props as ShellProps } from "@components/shell/shell.astro";

export interface Props extends ShellProps {
  title?: string | undefined;
  description: string;
  canonicalURL?: string | undefined;
  image?: ImageMetadata | undefined;
}

const { title, description, canonicalURL, image, ...rest } = Astro.props;

const separator = "-";
const defaultTitle = `Alexander Gabriel Ho ${separator} Full Stack Web Developer`;
const suffixTitle = "Alexander Gabriel Ho";
const pageTitle = title ? `${title} ${separator} ${suffixTitle}` : defaultTitle;
---

<html lang="en">
  <head>
    <BaseHead title={pageTitle} description={description} canonicalURL={canonicalURL} image={image}>
      <slot name="head" slot="head" />
    </BaseHead>
  </head>
  <body>
    <Shell {...rest}>
      <slot />
    </Shell>
  </body>
</html>
