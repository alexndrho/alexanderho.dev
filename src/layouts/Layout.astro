---
import BaseLayout from "@/layouts/BaseLayout.astro";

export interface Props {
  title: string;
  description: string;
  canonicalURL?: string | undefined;
  image?: ImageMetadata | undefined;
  navbarStick?: boolean | undefined;
}

const { title, description, canonicalURL, image, navbarStick } = Astro.props;
---

<BaseLayout title={title} description={description} canonicalURL={canonicalURL} image={image} navbarStick={navbarStick}>
  <slot name="head" slot="head" />

  <slot />
</BaseLayout>
