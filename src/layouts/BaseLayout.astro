---
import BaseHead from "@components/BaseHead.astro";
import Shell from "@components/shell/Shell.astro";

export interface Props {
  title?: string | undefined;
  description: string;
  canonicalURL?: string | undefined;
  image?: ImageMetadata | undefined;
  navbarStick?: boolean | undefined;
}

const { title, description, canonicalURL, image, navbarStick } = Astro.props;

const separator = "-";
const defaultTitle = `Alexander Gabriel Ho ${separator} Full Stack Web Developer`;
const suffixTitle = "Alexander Gabriel Ho";
const pageTitle = title ? `${title} ${separator} ${suffixTitle}` : defaultTitle;
---

<html lang="en">
  <head>
    <BaseHead title={pageTitle} description={description} canonicalURL={canonicalURL} image={image}>
      <slot name="head" slot="head" />
    </BaseHead>
  </head>
  <body>
    <Shell navbarStick={navbarStick}>
      <slot />
    </Shell>
  </body>
</html>
