---
import BaseHead from "@components/BaseHead.astro";
import Shell from "@components/shell/Shell.astro";

interface Props {
  title: string;
  description: string;
  canonicalURL?: string | undefined;
  image?: ImageMetadata | undefined;
  navbarStick?: boolean | undefined;
}

const { title, description, canonicalURL, image, navbarStick } = Astro.props;
---

<html lang="en">
  <head>
    <BaseHead title={title} description={description} canonicalURL={canonicalURL} image={image}>
      <slot name="head" slot="head" />
    </BaseHead>
  </head>
  <body>
    <Shell navbarStick={navbarStick}>
      <slot />
    </Shell>
  </body>
</html>
