---
import Layout from "@/layouts/Layout.astro";
import CertificationsPreview from "@/components/CertificationsPreview.astro";
import { CertificationCategory, certifications } from "@/constants/certifications";
import { uppercaseFirst } from "@/utils/string";

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const canonicalHref = canonicalURL.toString().replace(/\/$/, "");
---

<Layout
  title="Certifications - Alexander Gabriel Ho | Full Stack Web Developer"
  description="Explore certifications earned by Alexander Gabriel Ho."
  canonicalURL={canonicalHref}
>
  <div class="layout layout--section">
    <h1>Certifications</h1>

    <p>Certifications I've earned along the way, each one marking something new I set out to learn.</p>

    <div class="certifications">
      {
        Object.values(CertificationCategory).map((category) => (
          <>
            <h2 class="certification__title">{uppercaseFirst(category)}</h2>

            <CertificationsPreview
              certifications={certifications.filter((certification) => category === certification.category)}
            />
          </>
        ))
      }
    </div>
  </div>

  <style>
    .certifications {
      display: flex;
      flex-direction: column;
      gap: var(--spacing-md);
    }

    .certification__title {
      margin-bottom: 0;
    }
  </style>
</Layout>
