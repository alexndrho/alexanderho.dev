---
import Layout from "@layouts/layout.astro";
import Home from "@components/sections/home.astro";
import About from "@components/sections/about.astro";
import Blog from "@/components/sections/blog.astro";
import Projects from "@components/sections/projects.astro";
import Gallery from "@/components/sections/gallery.astro";
import Certifications from "@components/sections/certifications.astro";
import Contact from "@/components/sections/contact.astro";

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const canonicalHref = canonicalURL.toString().replace(/\/$/, "");
---

<Layout
  description="Full Stack Web Developer crafting modern web experiences. Explore my portfolio, projects, and skills. Open to collaboration and new opportunities."
  canonicalURL={canonicalHref}
>
  <Home />
  <About />
  <Blog />
  <Projects />
  <Gallery />
  <Certifications />
  <Contact />
</Layout>
